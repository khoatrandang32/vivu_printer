{
  "name": "vivu-printer",
  "version": "1.0.0",
  "description": "NodeJS Print Server cho máy in nhiệt HPRT N43 (TSPL) trên Windows",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "build:exe": "pkg -t node18-win-x64 --output dist/vivu_printer_server.exe server.js",
    "build:electron": "electron-packager . \"VIVU Printer\" --platform=win32 --arch=x64 --out=dist-electron --overwrite --icon=public/icon.ico --no-asar --ignore=dist --ignore=dist-electron --ignore=.git --ignore=dist.rar",
    "build:installer": "electron-builder --win --x64",
    "build:all": "npm run build:installer"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "pkg": "^5.8.1"
  },
  "author": "",
  "license": "MIT",
  "pkg": {
    "assets": [
      "public/**/*",
      "returnSlipPrint.js"
    ]
  },
  "build": {
    "appId": "com.vivu.printer",
    "productName": "VIVU Printer",
    "copyright": "Copyright © 2026 VIVU",
    "directories": {
      "output": "dist-installer"
    },
    "asar": true,
    "files": [
      "main.js",
      "server.js",
      "returnSlipPrint.js",
      "otherCarrierShipPrint.js",
      "public/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/@electron/packager/**/*",
      "!node_modules/pkg/**/*",
      "!node_modules/pkg-fetch/**/*"
    ],
    "asarUnpack": [
      "server.js",
      "returnSlipPrint.js",
      "otherCarrierShipPrint.js",
      "public/**/*",
      "node_modules/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/@electron/packager/**/*",
      "!node_modules/pkg/**/*",
      "!node_modules/pkg-fetch/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VIVU Printer",
      "runAfterFinish": true
    }
  }
}
